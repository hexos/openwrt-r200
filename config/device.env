# R200 关键硬件/固件参数（全部来自对本地 R200-6.00.7 固件包的实际解析）
# 供 tools/ 下脚本与 GitHub Actions 使用。修改前请先跑 tools/fwdump.py 复核。

# ---- 设备 ----
DEVICE_NAME="Pinsu-R200"
DEVICE_SOC="Qualcomm SDX55 (sdxprairie, 4x Cortex-A7, armv7 32-bit)"
DEVICE_RAM="512 MiB"
DEVICE_FLASH="512 MiB SPI/并行 NAND"

# ---- NAND / UBI 几何（来自 sdxprairie-sysfs.ubi 的 EC/VID 头）----
NAND_PAGE_SIZE=4096            # -m
NAND_BLOCK_SIZE=262144         # -p  (256 KiB)
UBI_VID_HDR_OFFSET=4096        # -s
UBI_DATA_OFFSET=8192
UBI_LEB_SIZE=253952            # = 262144 - 8192，mkfs.ubifs -e
UBI_ERASE_COUNT=308            # 厂商 sysfs.ubi 镜像的块数（仅参考，实际由分区大小决定）

# ---- EDL 扇区单位 ----
SECTOR_SIZE=4096

# ---- 关键分区（来自 rawprogram_nand_p4K_b256K.xml，单位：扇区）----
PART_boot_start=8512
PART_boot_sectors=2816
PART_system_start=64832
PART_system_sectors=66240      # 258.75 MiB，OpenWrt 根文件系统写在这里
PART_modem_start=11584
PART_modem_sectors=25152
PART_m_webui_start=61120
PART_m_webui_sectors=3712
PART_usrdata_start=57408
PART_m_data_start=54720

# system 分区可容纳的 UBI 块数（含 2 个 layout 块）
SYSTEM_UBI_BLOCKS=$(( PART_system_sectors * SECTOR_SIZE / NAND_BLOCK_SIZE ))   # 1035

# ---- 厂商 UBI 卷名（system 分区内）----
# 依次为 vol_id 0..4；0/1 有数据，末尾的 persist/EFS 卷在厂商包里为空
UBI_VOL_0_NAME="rootfs"        # 原厂根文件系统所在卷 —— OpenWrt 根分区沿用此名
UBI_VOL_1_NAME="usrfs"
UBI_VOL_2_NAME="cachefs"
UBI_VOL_3_NAME="systemrw"
UBI_VOL_4_NAME="persist"

# ---- 原厂内核 ----
KERNEL_VERSION="4.14.206-perf"
KERNEL_ARCH="arm (32-bit, zImage, Cortex-A7)"
BOOTIMG_PAGE_SIZE=4096
BOOTIMG_CMDLINE="noinitrd ro rootwait androidboot.hardware=qcom msm_rtb.filter=0x237 lpm_levels.sleep_disabled=1 firmware_class.path=/lib/firmware/updates service_locator.enable=1 net.ifnames=0 atlantic_fwd.rx_ring_size=1024 pci=pcie_bus_perf"

# 原厂内核缺少、OpenWrt 用户空间需要绕开的能力（详见 docs/status.md）
KERNEL_HAS_OVERLAYFS=0         # CONFIG_OVERLAY_FS is not set
KERNEL_HAS_NFTABLES=0          # CONFIG_NF_TABLES is not set（iptables 为内建）
KERNEL_HAS_UBIFS=1             # CONFIG_UBIFS_FS=y

# ---- EDL ----
EDL_VID_PID="05c6:9008"
EDL_PROGRAMMER="prog_firehose_sdx55.mbn"
